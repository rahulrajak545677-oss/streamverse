# Copy to .env for local development:  cp .env.example .env
# Only PUBLIC values belong here. These are bundled into the app.
# Supabase Dashboard -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The "anon" / publishable key. It is safe to ship because Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NEVER put the service_role key in this file or anywhere in the app.
# It is only used by the delete-account Edge Function, where Supabase injects it automatically.
